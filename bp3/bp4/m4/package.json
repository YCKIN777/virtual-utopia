{
  "name": "virtual-utopia-bp4-m4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "test": "node --test backend/tests/*.test.js",
    "test:e2e": "node tests/bp4-m4.e2e.mjs",
    "check": "node --check backend/src/server.js && node --check backend/src/app.js && node --check backend/src/templateService.js && node --check backend/src/metricsAggregator.js && node --check frontend/src/main.js && npm run test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.63.0",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
