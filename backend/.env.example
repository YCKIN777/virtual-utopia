# ===== 虚拟乌托邦 BP2 v1.0 环境变量模板 =====
# 复制为 .env 并按需填写；生产环境务必通过环境变量注入密钥，勿提交明文。

# --- phase5 主服务（端口 3300）---
PHASE5_AUTH_SECRET=changeme
PHASE5_SERVICE_TOKEN=changeme
PHASE5_BOOTSTRAP_ADMIN_USERNAME=admin
PHASE5_BOOTSTRAP_ADMIN_PASSWORD=utopia2026
PHASE5_DB_PATH=./data/virtual_utopia_phase5.sqlite
PHASE5_PORT=3300

# --- phase6 网关（端口 3400）---
PHASE5_BASE_URL=http://localhost:3300
PHASE6_PORT=3400
PHASE6_HOST=localhost
PHASE6_ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199,http://localhost:5173,http://localhost:5174,http://localhost:5175
PHASE6_AUDIT_DB_PATH=./data/phase6_audit.sqlite
PHASE6_QUOTA_DB_PATH=./data/phase6_visitor_quota.sqlite
PHASE6_PLOT_DB_PATH=./data/phase6_plot_assignment.sqlite
PHASE6_CARD_DB_PATH=./data/phase6_resident_cards.sqlite
PHASE6_GUESTBOOK_DB_PATH=./data/phase6_guestbook.sqlite
PHASE6_SOCIAL_DB_PATH=./data/phase6_resident_social.sqlite

# --- 运行时 ---
# 请求日志级别：error | warn | info | debug（生产建议 warn）
LOG_LEVEL=warn
# 全局限流（每分钟请求数），调试期可调大
GUARD_RATE_MAX=300
NODE_ENV=production

# --- DeepSeek（居民 AI 对话；留空则降级为 mock 回复）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
