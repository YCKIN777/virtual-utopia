# ===== 虚拟乌托邦 BP2 v1.0 环境变量模板 =====
# 复制为 .env 并按需填写；生产环境务必通过环境变量注入密钥，勿提交明文。

# --- phase5 主服务（端口 3300）---
PHASE5_AUTH_SECRET=changeme
PHASE5_SERVICE_TOKEN=changeme
PHASE5_BOOTSTRAP_ADMIN_USERNAME=admin
PHASE5_BOOTSTRAP_ADMIN_PASSWORD=utopia2026
PHASE5_DB_PATH=./data/virtual_utopia_phase5.sqlite
PHASE5_PORT=3300

# --- phase6 网关（端口 3400）---
PHASE5_BASE_URL=http://localhost:3300
PHASE6_PORT=3400
PHASE6_HOST=localhost
PHASE6_ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199,http://localhost:5173,http://localhost:5174,http://localhost:5175
PHASE6_AUDIT_DB_PATH=./data/phase6_audit.sqlite
PHASE6_QUOTA_DB_PATH=./data/phase6_visitor_quota.sqlite
PHASE6_PLOT_DB_PATH=./data/phase6_plot_assignment.sqlite
PHASE6_CARD_DB_PATH=./data/phase6_resident_cards.sqlite
PHASE6_GUESTBOOK_DB_PATH=./data/phase6_guestbook.sqlite
PHASE6_SOCIAL_DB_PATH=./data/phase6_resident_social.sqlite

# --- 运行时 ---
# 请求日志级别：error | warn | info | debug（生产建议 warn）
LOG_LEVEL=warn
# 全局限流（每分钟请求数），调试期可调大
GUARD_RATE_MAX=300
NODE_ENV=production

# --- 大模型：居民 AI 对话（二选一；都留空则降级为按人设区分的 mock 兜底回复）---
# 方案 A：DeepSeek 官方
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- AI 编排后端（P1 起生效）---
# langchain = LangChain 适配器（默认，走 @langchain/deepseek；错误码与旧客户端兼容）
# legacy    = 回退到自研 deepSeekClient（切换后重启服务生效）
AI_LLM_BACKEND=langchain
# --- RAG 引擎后端（P2 起生效）---
# langchain = 官方组件（RecursiveCharacterTextSplitter + Embeddings 接口 + Chroma 官方集成）
# legacy    = 回退到自研 rag（textChunker + 哈希向量 + 手写 upsert/query）
AI_RAG_BACKEND=langchain
# --- RAG 向量库：Chroma 连接与数据治理（P2，待办②）---
# 本机开发：node scripts/chroma.mjs start（Python venv，数据落 .chroma-data/，已在 .gitignore）
# 生产：Docker 或托管 Chroma（模板 deploy/chroma.docker-compose.yml），把 CHROMA_URL 指向远端；
#       https 地址自动启用 ssl（vectorStore.js 按协议判断）。
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=virtual_utopia_rag
RAG_DOCS_DIR=./backend/rag-docs
# LangSmith 可观测（P5.3-⑪）：LangChain/LangGraph 追踪由环境变量驱动（需安装 langsmith 包，已装 0.10.5）。
# Developer 免费层：5000 traces/月，可观测图执行/工具调用/审批流。开启步骤：
#   1) 到 https://smith.langchain.com 注册，Settings → API keys 生成 LANGSMITH_API_KEY（lsv2_ 开头）
#   2) 建项目（或默认）→ 把 LANGSMITH_PROJECT 设为项目名
#   3) 下面两项设为 true / 填入 key；无 key 时保持 false（否则每次请求打印 API key 缺失告警）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
# LANGSMITH_PROJECT=virtual-utopia
# --- 编排层后端（P3 起生效）---
# 1 = LangGraph StateGraph 编排（默认，居民 AI 对话试点：图状态机 + SQLite Checkpointer 短记忆）
# 0 = 回退旧 orchestrator（静态 if/else 路由，无服务端状态）
USE_LANGGRAPH=1
# P4 收尾：场景服务（3000）真实认证 —— AI 请求带 Bearer token 时经此地址调
# phase6 /api/phase6/auth/me 解析身份（替换 body.user 直传信任）；无 token=游客。
PHASE6_BASE_URL=http://localhost:3400
# P4 长记忆网关（默认开；false 关掉记忆节点，不注入/不落库）
# AI_MEMORY_ENABLED=true
# P4 HITL（KIN 审批）：默认开；命中 AI_APPROVAL_TOOLS 中的敏感工具时，
# 图经 interrupt 暂停，POST /api/scene/route/resume 以 Command({ resume }) 恢复。
AI_HITL_ENABLED=true
# 待办④：敏感工具审批清单（逗号分隔）—— guestbook_write（留言写入）+ query_friends（好友/私聊隐私）
AI_APPROVAL_TOOLS=guestbook_write
# 待办③：工具轮调试日志门控（默认关，生产无噪音）
# 排查工具轮（toolCalls/重调/兜底）时开：AI_TOOLS_DEBUG=true
AI_TOOLS_DEBUG=false

# 方案 B：硅基流动 SiliconFlow（OpenAI 兼容；未配 DeepSeek 时自动启用）
# 获取密钥：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# 注意：
# 1) 修改 .env 后需重启 phase6(3400) 才会生效（进程启动时读取）。
# 2) 只填非空值才会覆盖外部注入的环境变量；留空不会把已注入进程的 key 抹掉。
