{
  "name": "virtual-utopia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "check": "npm run build --workspace frontend && npm run test --workspace frontend && npm run check --workspace backend && npm test --workspace backend",
    "test:e2e": "node scripts/scene-flow.e2e.mjs",
    "test:all": "node scripts/test-all.mjs",
    "coverage": "c8 --reporter=text npm test --workspace backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8"
  }
}
