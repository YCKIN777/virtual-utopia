# 虚拟乌托邦 前端镜像（多阶段：3D 世界 + 管理后台 build → nginx 托管）
# 对齐 P5.4-⑯：shell 已下线，唯一入口为 3D 世界（world），管理后台走 /admin/。
#
# 构建：
#   docker build -f deploy/Dockerfile.frontend -t virtual-utopia-frontend .
# 说明：构建时注入 VITE_PHASE6_API_BASE_URL=/phase6-api 使前端走 nginx 同源反代
# （本地开发默认 http://localhost:3400，生产经 nginx 统一入口，避免跨域）。
FROM node:24-alpine AS build

# 容器内无代理：corepack 下载 pnpm 与 pnpm 拉包均走国内镜像（registry.npmjs.org 直连超时）
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
ENV npm_config_registry=https://registry.npmmirror.com
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY frontend ./frontend

# 双入口生产构建（node_modules 为 pnpm workspace hoisted 到根；shell 产物已下线不构建）
ARG VITE_PHASE6_API_BASE_URL=/phase6-api
ENV VITE_PHASE6_API_BASE_URL=${VITE_PHASE6_API_BASE_URL}
# 容器版管理后台走 nginx 同源 /admin/（本地开发缺省 localhost:5174）
ARG VITE_ADMIN_BASE_URL=/admin/
ENV VITE_ADMIN_BASE_URL=${VITE_ADMIN_BASE_URL}

RUN node node_modules/vite/bin/vite.js build --config frontend/src/virtual-utopia/vite.config.js \
 && node node_modules/vite/bin/vite.js build --config frontend/src/phase6/vite.config.js

# nginx 托管阶段
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/src/virtual-utopia/dist /usr/share/nginx/html/world
COPY --from=build /app/frontend/src/phase6/dist /usr/share/nginx/html/admin

EXPOSE 80
