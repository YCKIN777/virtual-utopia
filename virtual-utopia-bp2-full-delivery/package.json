{
  "name": "virtual-utopia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "check": "npm run build --workspace frontend && npm run test --workspace frontend && npm run check --workspace backend && npm test --workspace backend",
    "test:e2e": "node scripts/scene-flow.e2e.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0"
  }
}
